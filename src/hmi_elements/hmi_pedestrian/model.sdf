<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="hmi_pedestrian">
    <pose>0 0 0 0 0 0</pose>

    <link name="torso_link">
      <gravity>false</gravity>
      <pose>0 0 0.56 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.25</ixx>
          <iyy>0.20</iyy>
          <izz>0.18</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="torso_visual">
        <geometry><box><size>0.34 0.22 0.62</size></box></geometry>
        <material><ambient>0.18 0.44 0.74 1</ambient><diffuse>0.24 0.52 0.80 1</diffuse></material>
      </visual>
    </link>

    <link name="head_link">
      <gravity>false</gravity>
      <pose>0 0 1.07 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="head_visual">
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material><ambient>0.86 0.73 0.63 1</ambient><diffuse>0.90 0.78 0.68 1</diffuse></material>
      </visual>
    </link>

    <link name="left_leg_link">
      <gravity>false</gravity>
      <pose>0.00 0.06 0.29 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.10</ixx>
          <iyy>0.03</iyy>
          <izz>0.10</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="left_leg_visual">
        <pose>0 0 -0.38 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.76</length></cylinder></geometry>
        <material><ambient>0.14 0.16 0.20 1</ambient><diffuse>0.18 0.20 0.26 1</diffuse></material>
      </visual>
    </link>

    <link name="right_leg_link">
      <gravity>false</gravity>
      <pose>0.00 -0.06 0.29 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.10</ixx>
          <iyy>0.03</iyy>
          <izz>0.10</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="right_leg_visual">
        <pose>0 0 -0.38 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.76</length></cylinder></geometry>
        <material><ambient>0.14 0.16 0.20 1</ambient><diffuse>0.18 0.20 0.26 1</diffuse></material>
      </visual>
    </link>

    <link name="left_arm_link">
      <gravity>false</gravity>
      <pose>0.00 0.15 0.85 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.02</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="left_arm_visual">
        <pose>0 0 -0.28 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.56</length></cylinder></geometry>
        <material><ambient>0.86 0.73 0.63 1</ambient><diffuse>0.90 0.78 0.68 1</diffuse></material>
      </visual>
    </link>

    <link name="right_arm_link">
      <gravity>false</gravity>
      <pose>0.00 -0.15 0.85 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.02</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="right_arm_visual">
        <pose>0 0 -0.28 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.56</length></cylinder></geometry>
        <material><ambient>0.86 0.73 0.63 1</ambient><diffuse>0.90 0.78 0.68 1</diffuse></material>
      </visual>
    </link>

    <joint name="head_joint" type="fixed">
      <parent>torso_link</parent>
      <child>head_link</child>
    </joint>
    <joint name="left_leg_joint" type="revolute">
      <parent>torso_link</parent>
      <child>left_leg_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.7</lower><upper>0.7</upper></limit>
        <dynamics><damping>1.0</damping></dynamics>
      </axis>
    </joint>
    <joint name="right_leg_joint" type="revolute">
      <parent>torso_link</parent>
      <child>right_leg_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.7</lower><upper>0.7</upper></limit>
        <dynamics><damping>1.0</damping></dynamics>
      </axis>
    </joint>
    <joint name="left_arm_joint" type="revolute">
      <parent>torso_link</parent>
      <child>left_arm_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.9</lower><upper>0.9</upper></limit>
        <dynamics><damping>0.8</damping></dynamics>
      </axis>
    </joint>
    <joint name="right_arm_joint" type="revolute">
      <parent>torso_link</parent>
      <child>right_arm_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.9</lower><upper>0.9</upper></limit>
        <dynamics><damping>0.8</damping></dynamics>
      </axis>
    </joint>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_arm_joint</joint_name>
      <topic>left_arm_joint_cmd</topic>
      <p_gain>12</p_gain>
      <d_gain>0.8</d_gain>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_arm_joint</joint_name>
      <topic>right_arm_joint_cmd</topic>
      <p_gain>12</p_gain>
      <d_gain>0.8</d_gain>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_leg_joint</joint_name>
      <topic>left_leg_joint_cmd</topic>
      <p_gain>14</p_gain>
      <d_gain>1.0</d_gain>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_leg_joint</joint_name>
      <topic>right_leg_joint_cmd</topic>
      <p_gain>14</p_gain>
      <d_gain>1.0</d_gain>
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
    </plugin>
  </model>
</sdf>
