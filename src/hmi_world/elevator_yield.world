<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="elevator_yield">
    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.80 0.80 0.80 1</ambient>
      <background>0.95 0.96 0.97 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.25 0.10 -0.95</direction>
    </light>

    <model name="scene_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>10 10 0.06</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>10 10 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.88 0.88 0.86 1</ambient>
            <diffuse>0.93 0.93 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Open-source robot model from ROBOTIS TurtleBot3 simulations -->
    <model name="turtlebot3_burger_ir_1">
      <include>
        <uri>model://turtlebot3_burger_ir</uri>
        <pose>0.00 0.15 0.012 0 0 1.570796</pose>
        <static>true</static>
      </include>
    </model>

    <model name="elevator_car">
      <include>
        <uri>model://aws_robomaker_hospital_elevator_01_car</uri>
        <pose>0 1.65 0.19 0 0 0</pose>
      </include>
    </model>

    <model name="elevator_portal">
      <include>
        <uri>model://aws_robomaker_hospital_elevator_01_portal</uri>
        <pose>0 1.78 0.19 0 0 0</pose>
      </include>
    </model>

    <!-- Two wall panels sit on the same plane as the elevator sliding door. -->
    <model name="left_door_side_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>-1.57 1.74 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>1.50 0.22 2.90</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>-1.57 1.74 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>1.50 0.22 2.90</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.83 0.85 1</ambient>
            <diffuse>0.88 0.89 0.91 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_door_side_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>1.57 1.74 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>1.50 0.22 2.90</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>1.57 1.74 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>1.50 0.22 2.90</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.83 0.85 1</ambient>
            <diffuse>0.88 0.89 0.91 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Visible human mesh used only for rendering.
      Motion is driven externally so it stays stable in Gazebo Harmonic.
    -->
    <model name="human_in_elevator">
      <static>true</static>
      <pose>0.000004 3.219430 0.474502 0 0 -1.556373</pose>
      <link name="body_link">
        <visual name="torso_visual">
          <pose>0 0 0.56 0 0 0</pose>
          <geometry>
            <box>
              <size>0.34 0.22 0.62</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.44 0.74 1</ambient>
            <diffuse>0.24 0.52 0.80 1</diffuse>
          </material>
        </visual>
        <visual name="head_visual">
          <pose>0 0 1.07 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.11</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.86 0.73 0.63 1</ambient>
            <diffuse>0.90 0.78 0.68 1</diffuse>
          </material>
        </visual>
        <visual name="left_leg_visual">
          <pose>0 0.07 0.20 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.76</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.14 0.16 0.20 1</ambient>
            <diffuse>0.18 0.20 0.26 1</diffuse>
          </material>
        </visual>
        <visual name="right_leg_visual">
          <pose>0 -0.07 0.20 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.76</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.14 0.16 0.20 1</ambient>
            <diffuse>0.18 0.20 0.26 1</diffuse>
          </material>
        </visual>
        <visual name="left_arm_visual">
          <pose>0 0.19 0.58 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.56</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.86 0.73 0.63 1</ambient>
            <diffuse>0.90 0.78 0.68 1</diffuse>
          </material>
        </visual>
        <visual name="right_arm_visual">
          <pose>0 -0.19 0.58 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.56</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.86 0.73 0.63 1</ambient>
            <diffuse>0.90 0.78 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Hidden collision proxy for obstacle handling.
      This stays aligned with the human while the actor is static.
    -->
    <model name="human_collision_proxy">
      <static>true</static>
      <pose>0.000004 3.219430 0.960000 0 0 -1.556373</pose>
      <link name="collision_link">
        <collision name="body_collision">
          <geometry>
            <box>
              <size>0.95 0.60 1.72</size>
            </box>
          </geometry>
        </collision>
        <visual name="debug_visual">
          <geometry>
            <box>
              <size>0.95 0.60 1.72</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 0.35</ambient>
            <diffuse>0.2 0.8 0.2 0.35</diffuse>
          </material>
          <transparency>0.65</transparency>
        </visual>
      </link>
    </model>

    <!-- Corridor walls attach to the outer sides of the two door-side wall panels. -->
    <model name="left_corridor_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>-2.43 -2.75 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>0.22 9.00 2.90</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>-2.43 -2.75 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>0.22 9.00 2.90</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.83 0.85 1</ambient>
            <diffuse>0.88 0.89 0.91 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_corridor_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>2.43 -2.75 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>0.22 9.00 2.90</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>2.43 -2.75 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>0.22 9.00 2.90</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.83 0.85 1</ambient>
            <diffuse>0.88 0.89 0.91 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static obstacle behind the robot, about 3 m away from the elevator door plane. -->
    <model name="rear_obstacle">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>1.77 -1.26 0.75 0 0 0</pose>
          <geometry>
            <box>
              <size>1.10 0.55 1.50</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>1.77 -1.26 0.75 0 0 0</pose>
          <geometry>
            <box>
              <size>1.10 0.55 1.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.66 0.56 0.46 1</ambient>
            <diffuse>0.74 0.64 0.54 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-3.9 -4.6 3.1 0 0.36 0.94</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
